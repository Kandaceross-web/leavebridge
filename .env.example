# LeaveBridge Health environment. Copy to .env for local development.
# Local values below are fictional and only work in development/test.
# In staging/production every secret comes from the secret manager, never from a file.
# The app refuses to start in staging/production with development keys or dev providers.

APP_ENV=development                     # development | test | staging | production
DATABASE_URL=postgres://lb_app:lb_app_dev@localhost:5432/leavebridge   # runtime role (not the table owner)
MIGRATION_DATABASE_URL=postgres://lb_owner:lb_owner_dev@localhost:5432/leavebridge  # migrations only
APP_ORIGIN=http://localhost:3000
SITE_ORIGIN=http://localhost:3000
HOST_MODE=single                        # single | split (www = marketing, app = portal/ops). Production: split (OWN-16)
# Production (OWN-16, domain bought 2026-10-09): SITE_ORIGIN=https://www.leavebridgehealth.com APP_ORIGIN=https://app.leavebridgehealth.com HOST_MODE=split
# With split hosts, share the first-party attribution cookie across both: ATTRIBUTION_COOKIE_DOMAIN=.leavebridgehealth.com
# ATTRIBUTION_COOKIE_DOMAIN=

# Keyring "id:base64(32 bytes)", comma separated. First entry encrypts; all entries decrypt.
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=dev1:ZGV2LW9ubHktZmljdGlvbmFsLWtleS0zMi1ieXRlISE=
HMAC_SECRET=dev-only-hmac-secret-change-me

PAYMENTS_PROVIDER=fake                  # fake | stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

STORAGE_PROVIDER=local                  # local | s3
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=
# S3_REGION=
# S3_KMS_KEY_ID=

SCAN_PROVIDER=basic                     # basic (type + signature checks) | clamav
# CLAMAV_HOST=localhost:3310

EMAIL_PROVIDER=outbox                   # outbox (stored, not sent) | ses
SMS_PROVIDER=outbox                     # outbox | sns
EMAIL_FROM="LeaveBridge Health <no-reply@leavebridgehealth.com>"   # SES needs the domain verified (docs/DEPLOYMENT.md)

VIDEO_PROVIDER=stub                     # stub (no call) or chime (Amazon Chime SDK, OWN-15)
# CHIME_REGION=us-east-1                # required with chime; AWS credentials come from the credential chain
# CHIME_MEDIA_REGION=us-east-1          # optional; defaults to CHIME_REGION
AI_PROVIDER=disabled                    # disabled | stub (dev only) | bedrock
# BEDROCK_MODEL_ID=
IDV_PROVIDER=manual                     # manual staff review until a vendor is chosen (OWN-04)

# Optional privacy-preserving analytics for marketing pages only. Never loaded on portal/ops routes.
# SITE_ANALYTICS_SRC=
